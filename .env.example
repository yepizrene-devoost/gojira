# Jira Cloud Configuration
# Your Atlassian email address
JIRA_EMAIL=your-email@example.com

# Your Atlassian API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-api-token-here

# Your Jira domain (e.g., yourcompany.atlassian.net)
JIRA_DOMAIN=your-domain.atlassian.net

# Optional: Project key to filter (leave empty for all projects)
JIRA_PROJECT_KEY=
